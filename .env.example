# Frontend (Vite) — copy to .env.local for local dev
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_local_publishable_key

# Optional: restrict admin/partner login emails
VITE_ADMIN_EMAILS=admin@example.com
VITE_PARTNER_EMAILS=partner@example.com

# Edge Functions (local only) — copy to supabase/.env.local
# Do NOT prefix with VITE_; these stay server-side in Edge Functions.
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-flash

# Transactional email (service review after job completion)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Dent Vision <reviews@yourdomain.com>

# WhatsApp alerts (Twilio) — primary channel for new lead dispatch
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional production template Content SID (sandbox can use Body text instead)
TWILIO_WHATSAPP_CONTENT_SID=

# Web Push (PWA partner alerts)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:hello@yourdomain.com

# Public app URL for magic links in WhatsApp/email (no trailing slash)
APP_PUBLIC_URL=http://localhost:5173

# Frontend — Web Push public key (same as VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VITE_APP_PUBLIC_URL=http://localhost:5173

# Production (Netlify / hosting dashboard)
# VITE_SUPABASE_URL=https://wtfstakxspbnghalelby.supabase.co
# VITE_SUPABASE_ANON_KEY=your_production_publishable_key
#
# After deploy, set Edge Function secrets on the Supabase project:
#   supabase secrets set --env-file supabase/.env.local --project-ref wtfstakxspbnghalelby
