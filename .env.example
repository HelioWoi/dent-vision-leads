# Frontend (Vite) — copy to .env.local for local dev
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_local_publishable_key

# Optional: restrict admin/partner login emails
VITE_ADMIN_EMAILS=admin@example.com
VITE_PARTNER_EMAILS=partner@example.com

# Edge Functions (local only) — copy to supabase/.env.local
# Do NOT prefix with VITE_; these stay server-side in Edge Functions.
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-flash

# Production (Netlify / hosting dashboard)
# VITE_SUPABASE_URL=https://wtfstakxspbnghalelby.supabase.co
# VITE_SUPABASE_ANON_KEY=your_production_publishable_key
#
# After deploy, set Edge Function secrets on the Supabase project:
#   supabase secrets set --env-file supabase/.env.local --project-ref wtfstakxspbnghalelby
