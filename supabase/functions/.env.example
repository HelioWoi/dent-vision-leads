# Copy to supabase/functions/.env for local Edge Functions (auto-loaded on supabase start)
# Or: cp supabase/.env.local supabase/functions/.env
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-flash
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Dent Vision <reviews@yourdomain.com>
